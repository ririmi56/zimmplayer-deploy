# ---------------------------------------------------------------------------
# Copier vers .env a la racine, a cote de docker-compose.yml.
# ---------------------------------------------------------------------------

# OBLIGATOIRE. Adresse exacte tapee par les utilisateurs, port compris.
# Les URLs audio sont signees pour cette adresse : si elle ne correspond pas,
# MinIO rejette la signature et aucune lecture ne fonctionne.
#   exemples : http://192.168.10.20   http://musique.interne:8080
PUBLIC_BASE_URL=http://localhost

# Port d'ecoute de l'application.
HTTP_PORT=80

# Secrets de la base. A changer imperativement.
DB_ROOT_PASSWORD=changez-moi-root
DB_PASSWORD=changez-moi

# --- Stockage S3/MinIO (OBLIGATOIRE) ----------------------------------------
# Ce compose ne fournit pas de stockage : renseigner ici le MinIO deja present
# sur le reseau. L'application ne fait jamais que lister et lire le bucket, un
# compte dedie suffit donc — inutile d'utiliser le compte root, voir la policy
# documentee dans README.md.
S3_ENDPOINT=http://mon-minio-existant:9000
S3_ACCESS_KEY=zimmplayer-reader
S3_SECRET_KEY=une-cle-secrete-dediee

# Bucket contenant la musique, organisee en Artiste/Album/NN - Titre.ext
S3_BUCKET=music
# Sous-dossier a indexer dans le bucket, vide pour tout indexer.
S3_PREFIX=
# Region annoncee dans la signature SigV4. MinIO accepte n'importe quelle
# valeur ; un vrai S3 exige celle du bucket, faute de quoi il rejette la
# signature.
S3_REGION=us-east-1

# --- MinIO jetable pour un essai local (facultatif) --------------------------
# Un service `minio` est fourni pour essayer la stack sans stockage sous la
# main. Il n'est PAS demarre par defaut :
#
#     docker compose --profile minio up -d
#
# Dans ce cas seulement, pointer S3_ENDPOINT sur ce service et faire
# correspondre les identifiants :
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=changez-moi-aussi
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=changez-moi-aussi

# Telechargements paralleles pendant un scan.
SCAN_CONCURRENCY=8

# Versions des images a deployer (voir les tags disponibles sur GHCR : sha
# court, X.Y.Z, ou latest = dernier commit sur master de chaque depot).
FRONT_TAG=latest
BACK_TAG=latest

# --- Snapcast (facultatif) --------------------------------------------------
# Ces valeurs ne sont que des defauts : l'ecran Configuration de l'application
# permet de les modifier a chaud, sans redeploiement. Necessite un snapserver
# deja present sur le reseau (non fourni par ce compose).

SNAPCAST_ENABLED=false
# Serveur Snapcast existant sur le reseau, et le port de son serveur HTTP :
# celui-ci porte a la fois le controle JSON-RPC (/jsonrpc) et l'audio
# (/stream). C'est le seul port de snapserver que l'API utilise — le port de
# controle TCP 1705 ne sert plus.
SNAPCAST_HOST=
SNAPCAST_HTTP_PORT=1780

# OBLIGATOIRE si Snapcast est active. Adresse par laquelle SNAPSERVER joint
# cette API pour venir chercher l'audio. C'est l'inverse du sens habituel :
# c'est snapserver qui se connecte a nous. Doit etre joignable depuis lui.
# Un nom d'hote convient (l'API le resout elle-meme en IP a chaque flux) :
# en k8s, pointer vers un Service stable, jamais vers l'IP d'un pod.
SNAPCAST_ADVERTISE_HOST=

# Plage de ports ouverts par l'API, un par session diffusee simultanement.
# SNAPCAST_PORT_END doit valoir START + COUNT - 1 (publication Docker).
SNAPCAST_PORT_START=4960
SNAPCAST_PORT_COUNT=8
SNAPCAST_PORT_END=4967

# TLS vers snapserver (wss:// et JSON-RPC chiffre). Contrairement aux reglages
# ci-dessus, ceux-ci ne sont PAS modifiables depuis l'ecran Configuration : ils
# exigent un redeploiement. Snapserver ne chiffre pas lui-meme -> suppose un
# reverse proxy TLS devant lui, SNAPCAST_HTTP_PORT pointant sur ce proxy.
SNAPCAST_TLS=false
# Vide = magasin de certificats du systeme ; sinon le certificat de VOTRE
# autorite, indispensable en airgap. Chemin VU DEPUIS LE CONTENEUR api : il
# faut donc aussi monter le fichier (voir README.md).
SNAPCAST_TLS_CA_FILE=
# Nom verifie contre le certificat et envoye en SNI. Vide = SNAPCAST_HOST ; a
# renseigner si l'on joint le serveur par IP mais que le certificat porte un nom.
SNAPCAST_TLS_SERVER_NAME=
