# ---------------------------------------------------------------------------
# Copier vers .env a la racine, a cote de docker-compose.yml.
# ---------------------------------------------------------------------------

# OBLIGATOIRE. Adresse exacte tapee par les utilisateurs, port compris.
# Les URLs audio sont signees pour cette adresse : si elle ne correspond pas,
# MinIO rejette la signature et aucune lecture ne fonctionne.
#   exemples : http://192.168.10.20   http://musique.interne:8080
PUBLIC_BASE_URL=http://localhost

# Port d'ecoute de l'application.
HTTP_PORT=80

# Secrets. A changer imperativement.
DB_ROOT_PASSWORD=changez-moi-root
DB_PASSWORD=changez-moi
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changez-moi-aussi

# Bucket contenant la musique, organisee en Artiste/Album/NN - Titre.ext
S3_BUCKET=music
# Sous-dossier a indexer dans le bucket, vide pour tout indexer.
S3_PREFIX=

# Telechargements paralleles pendant un scan.
SCAN_CONCURRENCY=8

# Versions des images a deployer (voir les tags disponibles sur GHCR : sha
# court, X.Y.Z, ou latest = dernier commit sur master de chaque depot).
FRONT_TAG=latest
BACK_TAG=latest

# --- Snapcast (facultatif) --------------------------------------------------
# Ces valeurs ne sont que des defauts : l'ecran Configuration de l'application
# permet de les modifier a chaud, sans redeploiement. Necessite un snapserver
# deja present sur le reseau (non fourni par ce compose).

SNAPCAST_ENABLED=false
# Serveur Snapcast existant sur le reseau, et son port de controle JSON-RPC.
SNAPCAST_HOST=
SNAPCAST_PORT=1705

# OBLIGATOIRE si Snapcast est active. Adresse par laquelle SNAPSERVER joint
# cette API pour venir chercher l'audio. C'est l'inverse du sens habituel :
# c'est snapserver qui se connecte a nous. Doit etre joignable depuis lui.
SNAPCAST_ADVERTISE_HOST=

# Plage de ports ouverts par l'API, un par session diffusee simultanement.
# SNAPCAST_PORT_END doit valoir START + COUNT - 1 (publication Docker).
SNAPCAST_PORT_START=4960
SNAPCAST_PORT_COUNT=8
SNAPCAST_PORT_END=4967
